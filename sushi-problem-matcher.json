{
  "problemMatcher": [
    {
      "owner": "sushi-error",
      "pattern": [
        {
          "regexp": "^Sushi: (?>\\x1B\\[[0-9;]*m)*(error)(?>\\x1B\\[[0-9;]*m)* (.+)\\s+\\([^)]+\\)$",
          "severity": 1,
          "message": 2
        },
        {
          "regexp": "^Sushi:   File: (.+)\\s+\\([^)]+\\)$",
          "file": 1
        },
        {
          "regexp": "^Sushi:   Line: (\\d+)( - (\\d+))?\\s+\\([^)]+\\)$",
          "line": 1
        }
      ]
    },
    {
      "owner": "sushi-warning",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^Sushi: (?>\\x1B\\[[0-9;]*m)*(warn\\s)(?>\\x1B\\[[0-9;]*m)* (.+)\\s+\\([^)]+\\)$",
          "message": 2
        },
        {
          "regexp": "^Sushi:   File: (.+)\\s+\\([^)]+\\)$",
          "file": 1
        },
        {
          "regexp": "^Sushi:   Line: (\\d+)( - (\\d+))?\\s+\\([^)]+\\)$",
          "line": 1
        }
      ]
    }
  ]
}
